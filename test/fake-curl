#!/bin/bash
# Stands in for curl in the tests: answers from fixture files instead of the
# network, and records what it was given so the tests can check the token
# never reached argv.
#
# Fixture lookup: $CF_TEST_FIXTURES/<name>.json, where name is
#   <dataset>-<range>   for GraphQL queries: dataset is workers|pages|do|do_store|
#                       kv|ai|d1|settings, range is "week" (query starts at
#                       $CF_TEST_SINCE) or "today"
#   verify-account / verify-user   for the token verify endpoints
# A matching .code file sets the HTTP status (default 200); a missing .json
# simulates a network failure.
set -u
config=$(cat)   # poll passes the auth header as a curl config on stdin (-K -)
printf '%s\n' "$*" >>"$CF_TEST_DIR/curl-argv.log"
printf '%s\n' "$config" >>"$CF_TEST_DIR/curl-stdin.log"

url=${!#}
body=""
while (( $# )); do
  if [[ $1 == --data-binary ]]; then body=$2; shift; fi
  shift
done

case $url in
  */accounts/*/tokens/verify) name=verify-account ;;
  */user/tokens/verify)       name=verify-user ;;
  *)
    query=$(jq -r .query <<<"$body")
    case $query in
      *settings*)                                ds=settings ;;
      *workersInvocationsAdaptive*)              ds=workers ;;
      *pagesFunctionsInvocationsAdaptiveGroups*) ds=pages ;;
      *durableObjectsInvocationsAdaptiveGroups*) ds=do ;;
      *durableObjectsPeriodicGroups*)            ds=do_store ;;
      *kvOperationsAdaptiveGroups*)              ds=kv ;;
      *aiInferenceAdaptiveGroups*)               ds=ai ;;
      *d1AnalyticsAdaptiveGroups*)               ds=d1 ;;
      *) echo "fake-curl: unknown query" >&2; printf '\n000'; exit 3 ;;
    esac
    range=today
    [[ $query == *"$CF_TEST_SINCE"* ]] && range=week
    name=$ds-$range ;;
esac
printf '%s\n' "$name" >>"$CF_TEST_DIR/curl-calls.log"

file=$CF_TEST_FIXTURES/$name.json
if [[ ! -f $file ]]; then
  echo "curl: (6) Could not resolve host: api.cloudflare.com" >&2
  printf '\n000'
  exit 6
fi
code=200
[[ -f ${file%.json}.code ]] && code=$(<"${file%.json}.code")
cat "$file"
printf '\n%s' "$code"
