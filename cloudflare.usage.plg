<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name    "cloudflare.usage">
<!ENTITY author  "Trevor Foren">
<!ENTITY version "2026.11.12c">
<!ENTITY plugdir "/usr/local/emhttp/plugins/cloudflare.usage">
]>
<!-- Generated by build.sh from src/. Edit the sources, not this file. -->
<PLUGIN name="&name;" author="&author;" version="&version;" min="7.0.0" icon="cloud" launch="Settings/CloudflareUsage" support="https://github.com/trevor4n/unraid-cloudflare-usage/issues" pluginURL="https://raw.githubusercontent.com/trevor4n/unraid-cloudflare-usage/main/cloudflare.usage.plg">

<CHANGES>
###2026.11.12c
- The install and update output is just the version line, plus a pointer to the settings page while the plugin isn't set up. It no longer prints the account ID.

###2026.11.12b
- Settings page (Settings, User Utilities, Cloudflare Usage; or click the plugin icon): enter the account ID and API token, test the connection, see status and token expiry. The token is write-only.
- Warns 30 days before the API token expires, then alerts at 7 days and 1 day.
- Tracks KV reads, writes, deletes and lists, and Workers AI neurons; their bars appear once used in the last 7 days.
- Pages Functions requests are added to the Workers bar, since they share its cap.
- Warns once a day when Worker errors are high (at least 50 failed requests and 5% of requests).
- Plugin description on the Plugins page, a settings link on the tile, and the version and setup status in the install output.

###2026.11.12a
- The tile wraps its own text, so a long setup message no longer widens every Dashboard tile on narrow screens.
- Before the first update the tile shows when the checker last ran, instead of a "no fresh data" warning.
- Clearer message when the token file is empty.

###2026.11.12
- First release: Dashboard tile for Cloudflare Workers Free plan daily caps (Workers, Durable Objects, D1), with Unraid notifications at 75% and 90% of each cap.
</CHANGES>

<!-- The plugin manager never overwrites an existing file, so clear the old copy first. -->
<FILE Run="/bin/bash">
<INLINE>
rm -rf &plugdir;
</INLINE>
</FILE>

<FILE Name="&plugdir;/README.md" Mode="0644">
<INLINE><![CDATA[
**Cloudflare Usage**

A Dashboard tile with today's Cloudflare Workers Free plan usage against each daily cap: Workers and Pages Functions requests, Durable Objects, D1, plus KV and Workers AI once you use them. Unraid notifications at 75% and 90% of a cap, before the API token expires, and when Worker errors spike. Click the icon to set it up. Not affiliated with Cloudflare.
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/CloudflareUsageTile.page" Mode="0644">
<INLINE><![CDATA[
Menu="Dashboard:0"
Markdown="false"
---
<?PHP
/* cloudflare.usage: adds the Cloudflare free-plan usage tile to the Dashboard.
 *
 * Follows DashboardCustomTileExample.page in unraid/webgui: "Dashboard:0" sorts
 * this page ahead of DashStats.page, which prints $mytiles into its columns.
 * The tile reads only the local cache written by scripts/poll.
 */
require_once "$docroot/plugins/cloudflare.usage/include/tile.php";
$mytiles['cloudflare.usage']['column2'] = cfu_tile();
?>
<link type="text/css" rel="stylesheet" href="<?autov('/plugins/cloudflare.usage/tile.css')?>">
<script src="<?autov('/plugins/cloudflare.usage/tile.js')?>"></script>
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/CloudflareUsage.page" Mode="0644">
<INLINE><![CDATA[
Menu="Utilities"
Title="Cloudflare Usage"
Icon="cloud"
Tag="cloud"
Markdown="false"
---
<?PHP
/* cloudflare.usage: settings page (Settings → User Utilities → Cloudflare Usage).
 * The plugin's icon on the Plugins page links here (launch attribute).
 * The token is write-only: this page never shows it, not even partly.
 */
require_once "$docroot/plugins/cloudflare.usage/include/settings_lib.php";
$cfu_st = cfu_status(CFU_CFG_DIR, CFU_STATE.'/usage.json');
$cfu_h = fn($s) => htmlspecialchars((string)$s, ENT_QUOTES, 'UTF-8');
$cfu_when = fn($t) => $t ? date('j M Y, H:i', $t) : '';
$cfu_exp = (int)($cfu_st['token']['expires'] ?? 0);
?>
<style>
#cfu-settings .cfu-ok { color: var(--green-800, #4f8a10); }
#cfu-settings .cfu-bad { color: var(--orange-500, #ff8c2f); }
#cfu-settings input[name=account_id], #cfu-settings input[name=token] { width: 34ch; font-family: monospace; }
#cfu-settings pre { white-space: pre-wrap; overflow-wrap: anywhere; max-width: 100%; }
</style>
<div id="cfu-settings">
<p>Shows today's Cloudflare Workers Free plan usage on the Dashboard and sends Unraid notifications at 75% and 90%
of each daily cap, before the API token expires, and when Worker errors spike.
It needs your account ID and a read-only API token with one permission: <b>Account Analytics: Read</b>.</p>

<form id="cfu-form" autocomplete="off" onsubmit="return false">
<dl>
<dt>Cloudflare account ID:</dt>
<dd><input type="text" name="account_id" value="<?=$cfu_h($cfu_st['account'])?>" maxlength="32" spellcheck="false"
  placeholder="32 characters, from your dashboard URL"></dd>
</dl>
<dl>
<dt>API token:</dt>
<dd><input type="password" name="token" autocomplete="new-password" spellcheck="false"
  placeholder="<?=$cfu_st['token_saved'] ? 'Saved. Paste a new one to replace it.' : 'Paste the token here'?>">
  <a href="<?=$cfu_h(CFU_TOKEN_TEMPLATE)?>" target="_blank" rel="noopener noreferrer">Create a token</a></dd>
</dl>
<dl>
<dt>&nbsp;</dt>
<dd><button type="button" id="cfu-save">Save and test</button>
  <button type="button" id="cfu-test"<?=$cfu_st['token_saved'] && $cfu_st['account'] ? '' : ' disabled'?>>Test connection</button></dd>
</dl>
</form>
<dl id="cfu-result" hidden>
<dt>Result:</dt>
<dd><span id="cfu-message"></span><pre id="cfu-check" hidden></pre></dd>
</dl>

<dl>
<dt>Status:</dt>
<dd><?php if ($cfu_st['setup_error']): ?>
  <span class="cfu-bad"><?=$cfu_h($cfu_st['setup_error'])?></span>
<?php elseif ($cfu_st['updated']): ?>
  Last update <?=$cfu_h($cfu_when($cfu_st['updated']))?><?=$cfu_st['next'] ? ', next check '.$cfu_h(date('H:i', $cfu_st['next'])) : ''?>.
  <?php foreach ($cfu_st['errors'] as $cfu_e): ?><br><span class="cfu-bad">Last check failed: <?=$cfu_h($cfu_e)?></span><?php endforeach; ?>
<?php else: ?>
  No data yet.
<?php endif; ?></dd>
</dl>
<dl>
<dt>Token:</dt>
<dd><?php if (!$cfu_st['token_saved']): ?>Not saved yet.<?php else: ?>
  Saved <?=$cfu_h($cfu_when($cfu_st['token_mtime']))?>.
  <?php if (!empty($cfu_st['token']['status'])): ?>Cloudflare says it's <b><?=$cfu_h($cfu_st['token']['status'])?></b><?php
    if ($cfu_exp): $cfu_days = intdiv($cfu_exp - time(), 86400); ?>, expiring <span class="<?=$cfu_days <= 30 ? 'cfu-bad' : ''?>"><?=$cfu_h(gmdate('j M Y', $cfu_exp))?> (in <?=$cfu_days?> days)</span><?php
    else: ?>, with no expiry date<?php endif; ?>.<?php endif; ?>
<?php endif; ?></dd>
</dl>
<dl>
<dt>Alerts:</dt>
<dd>Unraid notifications: a warning at 75% and an alert at 90% of any cap; a warning 30 days before the token expires
  and alerts at 7 days and 1 day; a warning when Worker errors are high.
  To get alerts on your phone, add an agent (Discord, ntfy, Pushover…) for <i>Alerts</i> in
  <a href="/Settings/Notifications">Notification Settings</a>.</dd>
</dl>
<dl>
<dt>Advanced:</dt>
<dd>Caps and error thresholds can be changed in <code><?=$cfu_h(cfu_cfg_file(CFU_CFG_DIR))?></code>.
  Errors are logged to the syslog under <code>cloudflare.usage</code>.</dd>
</dl>
</div>

<script>
(function () {
  'use strict';
  var form = document.getElementById('cfu-form');
  var buttons = [document.getElementById('cfu-save'), document.getElementById('cfu-test')];
  var result = document.getElementById('cfu-result');
  var message = document.getElementById('cfu-message');
  var check = document.getElementById('cfu-check');

  function show(ok, text, detail) {
    result.hidden = false;
    message.className = ok ? 'cfu-ok' : 'cfu-bad';
    message.textContent = text;
    check.hidden = !detail;
    check.textContent = detail || '';
  }

  function send(action) {
    var body = new URLSearchParams({ csrf_token: csrf_token, action: action });
    if (action === 'save') {
      body.set('account_id', form.account_id.value.trim());
      body.set('token', form.token.value.trim());
    }
    buttons.forEach(function (b) { b.disabled = true; });
    show(true, action === 'save' ? 'Saving and checking with Cloudflare…' : 'Checking with Cloudflare…', '');
    fetch('/plugins/cloudflare.usage/include/save.php', { method: 'POST', body: body, credentials: 'same-origin' })
      .then(function (r) {
        return r.json().catch(function () { return { ok: false, message: 'Unexpected response (HTTP ' + r.status + ').' }; });
      })
      .then(function (d) {
        form.token.value = '';   // never leave the token sitting in the page
        show(d.ok, d.message || (d.error ? 'Refused: ' + d.error : 'Done.'), d.check);
        if (d.ok && action === 'save') setTimeout(function () { location.reload(); }, 8000);
      })
      .catch(function () { show(false, 'Could not reach the server.', ''); })
      .finally(function () { buttons.forEach(function (b) { b.disabled = false; }); });
  }

  buttons[0].addEventListener('click', function () { send('save'); });
  buttons[1].addEventListener('click', function () { send('check'); });
})();
</script>
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/include/tile.php" Mode="0644">
<INLINE><![CDATA[
<?php
/* cloudflare.usage: renders the Dashboard tile from the JSON cache written by scripts/poll.
 *
 * It reads only that cache file, so opening the Dashboard never calls Cloudflare,
 * and the cache never holds the API token.
 *
 * CloudflareUsageTile.page includes this file to build the tile. tile.js also fetches
 * it directly every few minutes to refresh the tile body on a long-open Dashboard.
 */

if (!defined('CFU_CACHE')) define('CFU_CACHE', '/var/local/cloudflare.usage/usage.json'); // tests point this elsewhere
const CFU_SETTINGS = '/Settings/CloudflareUsage';
const CFU_STALE = 1800; // seconds without fresh data before the tile flags it

function cfu_h($s) {
  return htmlspecialchars((string)$s, ENT_QUOTES, 'UTF-8');
}

// Bar colour: below 50%, 50-75%, 75-90%, 90% and up.
function cfu_level($pct) {
  if ($pct >= 90) return 'red';
  if ($pct >= 75) return 'orange';
  if ($pct >= 50) return 'yellow';
  return 'green';
}

function cfu_pct_text($pct) {
  if ($pct > 0 && $pct < 1) return '<1%';
  return floor($pct).'%';
}

function cfu_load() {
  $raw = @file_get_contents(CFU_CACHE);
  if ($raw === false) return null;
  $data = json_decode($raw, true);
  return is_array($data) ? $data : null;
}

function cfu_dur($sec) {
  $min = (int)ceil(max(0, $sec) / 60);
  return $min >= 60 ? intdiv($min, 60).' h '.($min % 60).' min' : $min.' min';
}

// Inner HTML of the tile body. Uses only divs and spans: the Dashboard script
// treats every tbody element on the page as a tile (and needs its title), so a
// nested table here would break the whole Dashboard.
function cfu_body() {
  $d = cfu_load();
  if (!$d) {
    return "<div class='cfu-note'>No data yet. The first check runs right after install, then every 5 to 15 minutes depending on usage.</div>";
  }
  $now = time();
  $today = gmdate('Y-m-d', $now);
  $sameDay = ($d['day'] ?? '') === $today;
  $out = '';

  if (!empty($d['error'])) {
    $out .= "<div class='cfu-note cfu-warn'>".cfu_h($d['error'])
      ." <a href='".CFU_SETTINGS."'>Open settings</a></div>";
  }

  // Optional caps (KV, Workers AI) get a bar only once used this week.
  $all = $d['metrics'] ?? [];
  $shown = array_values(array_filter($all, fn($m) => $m['visible'] ?? true));
  $idle = array_values(array_filter($all, fn($m) => !($m['visible'] ?? true)));

  // Today's bars, one per cap.
  $updated = 0;
  foreach ($all as $m) $updated = max($updated, (int)($m['fetched'] ?? 0));
  foreach ($shown as $m) {
    $cap = max(1, (int)($m['cap'] ?? 1));
    $has = $sameDay && isset($m['value']) && is_numeric($m['value']);
    $val = $has ? (int)$m['value'] : 0;
    $pct = $val * 100 / $cap;
    $lvl = $has ? cfu_level($pct) : 'none';
    $label = cfu_h($m['label'] ?? $m['id'] ?? '?');
    $nums = ($has ? number_format($val) : '–').' / '.number_format($cap);
    $pctTxt = $has ? '<b>'.cfu_h(cfu_pct_text($pct)).'</b>' : '';
    $width = $has ? round(min(100, $pct), 1) : 0;
    $out .= "<div class='cfu-metric cfu-$lvl'>"
      ."<div class='cfu-line'><span class='cfu-label'>$label</span><span class='cfu-num'>$nums $pctTxt</span></div>"
      ."<div class='cfu-bar' role='meter' aria-label='$label' aria-valuemin='0' aria-valuemax='$cap' aria-valuenow='$val'>"
      ."<span style='width:$width%'></span></div>";
    if (($m['id'] ?? '') === 'workers' && $has) {
      // Pages Functions share this cap; failed requests are worth seeing early.
      $notes = [];
      if (!empty($m['pages'])) $notes[] = 'incl. '.number_format((int)$m['pages']).' Pages Functions';
      if (!empty($m['errors'])) {
        $rate = cfu_pct_text((int)$m['errors'] * 100 / max(1, (int)($m['requests_only'] ?? 0)));
        $notes[] = number_format((int)$m['errors']).' failed ('.$rate.')';
      }
      if ($notes) {
        $out .= "<div class='cfu-sub".(!empty($m['errors_high']) ? ' cfu-warn' : '')."'>".cfu_h(implode(' · ', $notes))."</div>";
      }
    }
    if (!empty($m['error'])) {
      $out .= "<div class='cfu-err'>Last check failed: ".cfu_h($m['error'])."</div>";
    }
    $out .= "</div>";
  }
  if ($idle) {
    // "KV" when none of its four caps were used; otherwise name each idle one.
    $kvIdle = count(array_filter($idle, fn($m) => str_starts_with($m['id'] ?? '', 'kv_'))) === 4;
    $list = $kvIdle ? ['KV'] : [];
    foreach ($idle as $m) {
      if ($kvIdle && str_starts_with($m['id'] ?? '', 'kv_')) continue;
      $list[] = ($m['id'] ?? '') === 'ai' ? 'Workers AI' : ($m['label'] ?? $m['id']);
    }
    $names = implode(', ', $list);
    $failing = array_filter($idle, fn($m) => !empty($m['error']));
    $out .= "<div class='cfu-sub'>Also watching, unused this week: ".cfu_h($names)
      .($failing ? " <span class='cfu-warn'>(check failing)</span>" : '')."</div>";
  }

  // Last 7 UTC days, each cell a small column scaled to that day's cap.
  $hist = $d['history'] ?? [];
  if ($hist) {
    $out .= "<div class='cfu-hist' aria-label='Last 7 days, share of each daily cap'>";
    $out .= "<span class='cfu-hist-title'>Last 7 days (UTC)</span>";
    foreach ($hist as $h) {
      $day = $h['day'] ?? '';
      $ts = strtotime("$day 00:00:00 UTC");
      $name = $day === $today ? 'Today' : ($ts ? gmdate('D', $ts) : '?');
      $out .= "<span class='cfu-hist-day' title='".cfu_h($day)."'>".cfu_h($name)."</span>";
    }
    foreach ($shown as $m) {
      $id = $m['id'] ?? '';
      $cap = max(1, (int)($m['cap'] ?? 1));
      $out .= "<span class='cfu-hist-label'>".cfu_h($m['short'] ?? $id)."</span>";
      foreach ($hist as $h) {
        $day = cfu_h($h['day'] ?? '');
        if (!isset($h[$id]) || !is_numeric($h[$id])) {
          $out .= "<span class='cfu-col cfu-col-none' title='$day: no data'></span>";
          continue;
        }
        $v = (int)$h[$id];
        $p = $v * 100 / $cap;
        $height = $v > 0 ? max(6, round(min(100, $p))) : 0;
        $tip = cfu_h("$day: ".number_format($v).' ('.cfu_pct_text($p).')');
        $out .= "<span class='cfu-col' title='$tip'><i class='cfu-".cfu_level($p)."' style='height:$height%'></i></span>";
      }
    }
    $out .= "</div>";
  }

  // Footer: last update and the next reset, in local time. tile.js keeps
  // the relative parts ("3 min ago", "in 5 h") current between page loads.
  $reset = (int)($d['reset'] ?? 0);
  // Stale means data that was fresh once and has stopped updating; before the
  // first update the setup hint or the per-cap errors say what's wrong instead.
  $stale = $updated && $now - $updated > CFU_STALE;
  $out .= "<div class='cfu-foot".($stale ? ' cfu-stale' : '')."' data-cfu-updated='$updated'>";
  $next = (int)($d['next'] ?? 0);
  if ($updated) {
    // Checks run every 15, 10 or 5 minutes depending on usage; "next" is when the next one is due.
    $out .= "<span>Updated <span data-cfu-time='$updated'>".date('H:i', $updated)."</span>"
      ." (<span data-cfu-ago='$updated'>".cfu_dur($now - $updated)." ago</span>)"
      .($next > $now ? ", next check <span data-cfu-time='$next'>".date('H:i', $next)."</span>" : '')
      ."</span>";
  } else {
    // Show the poller's last run, so it's visible that the schedule is working.
    $gen = (int)($d['generated'] ?? 0);
    $out .= "<span>Not updated yet"
      .($gen ? " (checker last ran <span data-cfu-time='$gen'>".date('H:i', $gen)."</span>)" : '')
      ."</span>";
  }
  if ($reset) {
    $out .= "<span>Resets <span data-cfu-reset='$reset'>in ".cfu_dur($reset - $now)."</span>"
      ." at <span data-cfu-time='$reset'>".date('H:i', $reset)."</span></span>";
  }
  $exp = (int)($d['token']['expires'] ?? 0);
  if ($exp) {
    $days = intdiv($exp - $now, 86400);
    $out .= "<span".($days <= 30 ? " class='cfu-warn'" : '').">API token expires ".cfu_h(gmdate('j M Y', $exp))
      .($days <= 30 ? " (".($days < 1 ? 'today' : "in $days days").")" : '')."</span>";
  }
  $out .= "<span class='cfu-stale-note'>No fresh data for over 30 minutes. Check the syslog (tag cloudflare.usage).</span>";
  $out .= "</div>";
  return $out;
}

// The whole tile in Unraid 7 dashboard markup (see DashboardCustomTileExample.page).
function cfu_tile() {
  $d = cfu_load();
  $acct = $d['account'] ?? '';
  $link = preg_match('/^[0-9a-f]{32}$/', $acct)
    ? "https://dash.cloudflare.com/$acct/workers-and-pages"
    : 'https://dash.cloudflare.com/';
  return "<tbody title='Cloudflare usage'>"
    ."<tr><td>"
    ."<span class='tile-header'>"
    ."<span class='tile-header-left'>"
    ."<i class='fa fa-cloud f32'></i>"
    ."<div class='section'>"
    ."<h3 class='tile-header-main'>Cloudflare</h3>"
    ."<span>Free plan usage today, resets 00:00 UTC</span><br>"
    ."</div>"
    ."</span>"
    ."<span class='tile-header-right'>"
    ."<span class='tile-header-right-controls'>"
    ."<a href='".CFU_SETTINGS."' title='Cloudflare Usage settings'><i class='fa fa-fw fa-cog control'></i></a>"
    ."<a href='".cfu_h($link)."' target='_blank' rel='noopener noreferrer' title='Open the Cloudflare dashboard'>"
    ."<i class='fa fa-fw fa-external-link control'></i></a>"
    ."</span>"
    ."</span>"
    ."</span>"
    ."</td></tr>"
    ."<tr><td id='cfu-body'>".cfu_body()."</td></tr>"
    ."</tbody>";
}

// Fetched directly by tile.js: return just the body.
if (realpath($_SERVER['SCRIPT_FILENAME'] ?? '') === __FILE__) {
  header('Content-Type: text/html; charset=utf-8');
  header('Cache-Control: no-store');
  echo cfu_body();
}
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/include/settings_lib.php" Mode="0644">
<INLINE><![CDATA[
<?php
/* cloudflare.usage: settings helpers shared by CloudflareUsage.page and save.php.
 *
 * Kept free of request handling so the tests can call it directly. Writes go
 * only to the plugin's own folder on the flash drive, the token is never read
 * back out, and nothing here touches a shell with user input.
 */

if (!defined('CFU_CFG_DIR')) define('CFU_CFG_DIR', '/boot/config/plugins/cloudflare.usage');
if (!defined('CFU_PLUG'))    define('CFU_PLUG', '/usr/local/emhttp/plugins/cloudflare.usage');
if (!defined('CFU_STATE'))   define('CFU_STATE', '/var/local/cloudflare.usage');

// Cloudflare's dashboard opens a pre-filled "create token" form from this link
// (Account Analytics: Read only); the user reviews it and clicks Create.
const CFU_TOKEN_TEMPLATE = 'https://dash.cloudflare.com/?to=/:account/api-tokens'
  .'&permissionGroupKeys=%5B%7B%22key%22%3A%22account_analytics%22%2C%22type%22%3A%22read%22%7D%5D'
  .'&name=Unraid%20Cloudflare%20Usage%20%28analytics%20read%29';

function cfu_cfg_file($dir) { return "$dir/cloudflare.usage.cfg"; }
function cfu_token_file($dir) { return "$dir/cf-api-token"; }

// KEY="value" pairs from the config file, read without executing anything.
function cfu_cfg_read($dir) {
  $out = [];
  $text = @file_get_contents(cfu_cfg_file($dir));
  if ($text === false) return $out;
  foreach (preg_split('/\r?\n/', $text) as $line) {
    if (preg_match('/^([A-Z0-9_]+)="?([^"]*)"?\s*$/', $line, $m)) $out[$m[1]] = $m[2];
  }
  return $out;
}

function cfu_valid_account($s) {
  $s = strtolower(trim((string)$s));
  return preg_match('/^[0-9a-f]{32}$/', $s) ? $s : null;
}

// Same rule as scripts/poll: the token ends up inside a quoted curl config line.
function cfu_valid_token($s) {
  return (bool)preg_match('#^[A-Za-z0-9._~+/=-]{20,256}$#', (string)$s);
}

// Write a file via a temp file in the same folder, then rename.
function cfu_write_atomic($path, $data, $mode = 0600) {
  $tmp = @tempnam(dirname($path), '.cfu');
  if ($tmp === false) return false;
  if (@file_put_contents($tmp, $data) === false) { @unlink($tmp); return false; }
  @chmod($tmp, $mode);
  if (!@rename($tmp, $path)) { @unlink($tmp); return false; }
  return true;
}

// Set KEY="value" in config text, replacing the line or appending one.
function cfu_cfg_set($text, $key, $value) {
  $line = $key.'="'.$value.'"';
  $pattern = '/^'.preg_quote($key, '/').'=.*$/m';
  return preg_match($pattern, $text) ? preg_replace($pattern, $line, $text, 1) : rtrim($text)."\n".$line."\n";
}

/* Save the account ID and, when given, a new token. An empty token keeps the
 * saved one. Returns [ok, message]; the message never contains the token. */
function cfu_save($dir, $defaultCfg, $account, $token) {
  $acct = cfu_valid_account($account);
  if ($acct === null) return [false, 'The account ID is 32 letters and numbers (0-9, a-f). Copy it from your Cloudflare dashboard URL.'];
  $token = trim((string)$token);
  $tokenFile = cfu_token_file($dir);
  if ($token === '' && !is_file($tokenFile)) return [false, 'Paste the API token too.'];
  if ($token !== '' && !cfu_valid_token($token)) return [false, "That doesn't look like a Cloudflare API token. Copy it again from the token's summary page."];

  if (!is_dir($dir) && !@mkdir($dir, 0700, true)) return [false, "Couldn't create $dir."];
  $cfg = @file_get_contents(cfu_cfg_file($dir));
  if ($cfg === false) $cfg = (string)@file_get_contents($defaultCfg);
  $cfg = cfu_cfg_set($cfg, 'ACCOUNT_ID', $acct);
  $cfg = cfu_cfg_set($cfg, 'TOKEN_FILE', $tokenFile);
  if (!cfu_write_atomic(cfu_cfg_file($dir), $cfg, 0600)) return [false, "Couldn't write the settings file."];
  if ($token !== '' && !cfu_write_atomic($tokenFile, $token."\n", 0600)) return [false, "Couldn't save the token."];
  return [true, 'Saved.'];
}

// What the settings page shows. Never includes the token itself.
function cfu_status($dir, $cache) {
  $cfg = cfu_cfg_read($dir);
  $tokenFile = $cfg['TOKEN_FILE'] ?? cfu_token_file($dir);
  $data = json_decode((string)@file_get_contents($cache), true);
  $data = is_array($data) ? $data : [];
  $updated = 0;
  $errors = [];
  foreach ($data['metrics'] ?? [] as $m) {
    $updated = max($updated, (int)($m['fetched'] ?? 0));
    if (!empty($m['error'])) $errors[] = $m['error'];
  }
  return [
    'account'      => cfu_valid_account($cfg['ACCOUNT_ID'] ?? '') ?? '',
    'token_saved'  => is_file($tokenFile) && filesize($tokenFile) > 0,
    'token_mtime'  => is_file($tokenFile) ? filemtime($tokenFile) : 0,
    'token'        => $data['token'] ?? [],
    'updated'      => $updated,
    'next'         => (int)($data['next'] ?? 0),
    'setup_error'  => (string)($data['error'] ?? ''),
    'errors'       => array_values(array_unique($errors)),
  ];
}

// Run `poll --check` and return [exit code, output]. Fixed command, no input.
function cfu_run_check($secret = '') {
  $lines = [];
  $rc = 1;
  exec(escapeshellarg(CFU_PLUG.'/scripts/poll').' --check 2>&1', $lines, $rc);
  $text = implode("\n", $lines);
  if ($secret !== '') $text = str_replace($secret, '[redacted]', $text);   // belt and braces; poll never prints it
  return [$rc, $text];
}

// Refresh the tile now rather than at the next scheduled check.
function cfu_refresh() {
  exec('setsid '.escapeshellarg(CFU_PLUG.'/scripts/poll').' >/dev/null 2>&1 &');
}
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/include/save.php" Mode="0644">
<INLINE><![CDATA[
<?php
/* cloudflare.usage: POST endpoint for the settings page.
 *
 * Unraid's local_prepend.php runs before this file and rejects any POST without
 * the session's csrf_token (403), and the web UI's login protects the URL.
 * The page posts URL-encoded fields (no multipart, no file uploads).
 *
 *   action=save   account_id, token (empty keeps the saved token)
 *   action=check  run `poll --check`
 */
require_once __DIR__.'/settings_lib.php';

header('Content-Type: application/json');
header('Cache-Control: no-store');

function cfu_reply($ok, $message, $check = null) {
  echo json_encode(['ok' => $ok, 'message' => $message, 'check' => $check]);
  exit;
}

if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') {
  http_response_code(405);
  cfu_reply(false, 'POST only.');
}

$action = $_POST['action'] ?? '';
$token = trim((string)($_POST['token'] ?? ''));

if ($action === 'save') {
  [$ok, $message] = cfu_save(CFU_CFG_DIR, CFU_PLUG.'/cloudflare.usage.cfg.default', $_POST['account_id'] ?? '', $token);
  if (!$ok) cfu_reply(false, $message);
  [$rc, $check] = cfu_run_check($token);
  cfu_refresh();
  cfu_reply($rc === 0,
    $rc === 0 ? 'Saved, and the token works. The Dashboard tile updates within a minute.'
              : 'Saved, but the check below found a problem.',
    $check);
}

if ($action === 'check') {
  [$rc, $check] = cfu_run_check();
  cfu_reply($rc === 0, $rc === 0 ? 'The token works.' : 'The check found a problem.', $check);
}

http_response_code(400);
cfu_reply(false, 'Unknown action.');
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/tile.css" Mode="0644">
<INLINE><![CDATA[
/* cloudflare.usage Dashboard tile. Colours come from the Unraid theme palette, with fallbacks. */
#cfu-body {
  --cfu-green: var(--green-500, #17bf0b);
  --cfu-yellow: var(--yellow-500, #ffd324);
  --cfu-orange: var(--orange-500, #ff8c2f);
  --cfu-red: var(--red-700, #de1100);
  --cfu-track: var(--usage-disk-background-color, rgba(128, 128, 128, 0.25));
  --cfu-muted: var(--alt-text-color, #888);
}
/* Dashboard cells are nowrap; a long unbroken line here would widen every tile
   on narrow screens, so this tile wraps its own text. */
#cfu-body { white-space: normal; }
#cfu-body .cfu-note, #cfu-body .cfu-err, #cfu-body .cfu-stale-note { overflow-wrap: anywhere; }
#cfu-body .cfu-metric { margin: 0 0 0.9rem; }
#cfu-body .cfu-line {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
  margin-bottom: 0.3rem;
}
#cfu-body .cfu-num { font-variant-numeric: tabular-nums; white-space: nowrap; }
#cfu-body .cfu-num b { display: inline-block; min-width: 3.2em; text-align: right; }
#cfu-body .cfu-bar {
  position: relative;
  height: 0.8rem;
  border-radius: 0.2rem;
  overflow: hidden;
  /* tick marks at the 75% and 90% alert thresholds */
  background:
    linear-gradient(to right, transparent calc(75% - 1px), var(--cfu-muted) calc(75% - 1px), var(--cfu-muted) 75%, transparent 75%),
    linear-gradient(to right, transparent calc(90% - 1px), var(--cfu-muted) calc(90% - 1px), var(--cfu-muted) 90%, transparent 90%),
    var(--cfu-track);
}
#cfu-body .cfu-bar > span {
  position: absolute;
  inset: 0 auto 0 0;
  background: var(--cfu-green);
}
#cfu-body .cfu-yellow .cfu-bar > span, #cfu-body i.cfu-yellow { background: var(--cfu-yellow); }
#cfu-body .cfu-orange .cfu-bar > span, #cfu-body i.cfu-orange { background: var(--cfu-orange); }
#cfu-body .cfu-red .cfu-bar > span, #cfu-body i.cfu-red { background: var(--cfu-red); }
#cfu-body i.cfu-green { background: var(--cfu-green); }
#cfu-body .cfu-red .cfu-num b { color: var(--cfu-red); }
#cfu-body .cfu-err, #cfu-body .cfu-warn { color: var(--cfu-orange); margin-top: 0.3rem; }
#cfu-body .cfu-note { margin-bottom: 0.9rem; }
#cfu-body .cfu-sub { color: var(--cfu-muted); margin-top: 0.3rem; font-size: 0.9em; }
#cfu-body .cfu-sub.cfu-warn, #cfu-body .cfu-sub .cfu-warn, #cfu-body .cfu-foot .cfu-warn { color: var(--cfu-orange); }

#cfu-body .cfu-hist {
  display: grid;
  grid-template-columns: auto repeat(7, minmax(1.4rem, 1fr));
  align-items: end;
  gap: 0.25rem 0.4rem;
  margin: 1.2rem 0 0.9rem;
  font-size: 0.9em;
}
#cfu-body .cfu-hist-title, #cfu-body .cfu-hist-day { color: var(--cfu-muted); }
#cfu-body .cfu-hist-day { text-align: center; }
#cfu-body .cfu-hist-label { white-space: nowrap; padding-right: 0.4rem; }
#cfu-body .cfu-col {
  position: relative;
  height: 1.6rem;
  border-bottom: 1px solid var(--cfu-muted);
}
#cfu-body .cfu-col > i {
  position: absolute;
  left: 15%;
  right: 15%;
  bottom: 0;
  border-radius: 0.15rem 0.15rem 0 0;
}
#cfu-body .cfu-col-none { border-bottom-style: dotted; opacity: 0.5; }

#cfu-body .cfu-foot {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 0.3rem 1rem;
  color: var(--cfu-muted);
}
#cfu-body .cfu-stale-note { display: none; flex-basis: 100%; color: var(--cfu-orange); }
#cfu-body .cfu-stale .cfu-stale-note { display: block; }
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/tile.js" Mode="0644">
<INLINE><![CDATA[
/* cloudflare.usage: keeps the Cloudflare tile current while the Dashboard stays open.
 * Every 30 s it rewrites the relative times; every 5 min it reloads the tile body
 * from include/tile.php, which reads the local cache only (never Cloudflare). */
(function () {
  'use strict';
  var TICK_MS = 30 * 1000;
  var REFRESH_MS = 5 * 60 * 1000;
  var STALE_S = 1800;
  var lastRefresh = Date.now();

  function dur(sec) {
    var min = Math.ceil(Math.max(0, sec) / 60);
    return min >= 60 ? Math.floor(min / 60) + ' h ' + (min % 60) + ' min' : min + ' min';
  }

  function clock(epoch) {
    return new Date(epoch * 1000).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  }

  function each(root, sel, fn) {
    Array.prototype.forEach.call(root.querySelectorAll(sel), fn);
  }

  function tick() {
    var body = document.getElementById('cfu-body');
    if (!body) return;
    var now = Date.now() / 1000;
    each(body, '[data-cfu-time]', function (el) { el.textContent = clock(+el.getAttribute('data-cfu-time')); });
    each(body, '[data-cfu-ago]', function (el) {
      var s = now - el.getAttribute('data-cfu-ago');
      el.textContent = s < 60 ? 'just now' : dur(s) + ' ago';
    });
    each(body, '[data-cfu-reset]', function (el) {
      var s = el.getAttribute('data-cfu-reset') - now;
      el.textContent = s > 0 ? 'in ' + dur(s) : 'now, waiting for the next update';
    });
    each(body, '[data-cfu-updated]', function (el) {
      var u = +el.getAttribute('data-cfu-updated');
      el.classList.toggle('cfu-stale', u > 0 && now - u > STALE_S);
    });
  }

  function refresh() {
    lastRefresh = Date.now();
    fetch('/plugins/cloudflare.usage/include/tile.php', { credentials: 'same-origin', cache: 'no-store' })
      .then(function (r) { return r.ok ? r.text() : Promise.reject(r.status); })
      .then(function (html) {
        var body = document.getElementById('cfu-body');
        if (body) { body.innerHTML = html; tick(); }
      })
      .catch(function () { /* keep showing the last render; the stale note covers it */ });
  }

  function start() {
    tick();
    setInterval(tick, TICK_MS);
    setInterval(function () { if (!document.hidden) refresh(); }, REFRESH_MS);
    document.addEventListener('visibilitychange', function () {
      if (!document.hidden && Date.now() - lastRefresh > REFRESH_MS) refresh();
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
  else start();
})();
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/scripts/poll" Mode="0755">
<INLINE><![CDATA[
#!/bin/bash
# cloudflare.usage poller.
#
# Fetches today's (UTC) Cloudflare Workers Free plan usage from the GraphQL
# Analytics API, writes the JSON cache the Dashboard tile reads, and raises an
# Unraid notification at 75% and 90% of each daily cap, once per threshold per
# UTC day. It also warns before the API token expires, and when a Worker's
# error rate is high.
#
# Cron wakes it every 5 minutes with --cron; it only queries Cloudflare when a
# check is due. The gap between checks follows the busiest cap: 15 minutes
# below 75%, 10 minutes from 75%, 5 minutes from 85%. It is shortened further
# when the current growth rate would reach the next threshold (75%, 90%, the
# cap) before then, so a fast spike from low usage is still caught early.
#
# The API token is read from a file and handed to curl on stdin (curl -K -),
# so it never appears in the process list, the cache, or the logs.
#
#   poll           check now (used at install, by the settings page, and by hand)
#   poll --cron    check only if due (cron)
#   poll --check   print what the token can see and today's totals; writes nothing

set -uo pipefail
umask 077
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH   # cron's PATH is minimal

PLUGIN=cloudflare.usage
# The CF_USAGE_* overrides exist for the test suite.
CFG_DIR=${CF_USAGE_CFG_DIR:-/boot/config/plugins/$PLUGIN}
STATE_DIR=${CF_USAGE_STATE_DIR:-/var/local/$PLUGIN}
NOTIFY=${CF_USAGE_NOTIFY:-/usr/local/emhttp/webGui/scripts/notify}
CURL=${CF_USAGE_CURL:-curl}
LOGGER=${CF_USAGE_LOGGER:-logger}
API=${CF_USAGE_API:-https://api.cloudflare.com/client/v4/graphql}
API_BASE=${CF_USAGE_API_BASE:-https://api.cloudflare.com/client/v4}
NOW=${CF_USAGE_NOW:-$(date -u +%s)}

CFG=$CFG_DIR/$PLUGIN.cfg
CACHE=$STATE_DIR/usage.json            # read by the tile; never contains the token
HIST_RAM=$STATE_DIR/history.json       # per-day totals, last 7 UTC days
HIST_FLASH=$CFG_DIR/history.json       # completed days only, survives reboots
TOKEN_STATE=$STATE_DIR/token.json      # token status and expiry, checked once a day
ALERTS=$CFG_DIR/alerts.sent            # alerts already sent; written only when one fires
FAIL_SINCE=$STATE_DIR/failing-since    # first run in the current streak where every query failed
LAST_ERR=$STATE_DIR/last-error         # last error logged, to keep the syslog quiet
SETTINGS_LINK=/Settings/CloudflareUsage

FAIL_ALERT_AFTER=3000                  # seconds of total failure before one notification a day
CRON_SLACK=120                         # a cron wake-up this close to the due time counts as due
TOKEN_RECHECK=86400                    # look up the token's expiry once a day

CHECK=0 CRON=0
case ${1:-} in
  --check) CHECK=1 ;;
  --cron)  CRON=1 ;;
esac

log() { "$LOGGER" -t "$PLUGIN" -- "$*" 2>/dev/null || true; }

# Read KEY="value" from the config file without executing it. Tolerates CRLF
# line endings, in case the file was edited over SMB from Windows.
cfg() {
  local v=""
  [[ -r $CFG ]] && v=$(tr -d '\r' <"$CFG" | sed -n "s/^$1=\"\{0,1\}\([^\"]*\)\"\{0,1\}[[:space:]]*\$/\1/p" | tail -n 1)
  printf '%s' "${v:-$2}"
}

num_or() { [[ $1 =~ ^[0-9]+$ ]] && (( $1 > 0 )) && printf '%s' "$1" || printf '%s' "$2"; }

commas() { sed ':a;s/\B[0-9]\{3\}\>/,&/;ta' <<<"$1"; }

dur() { # seconds -> "5 h 12 min"
  local m=$(( ($1 + 59) / 60 ))
  if (( m >= 60 )); then printf '%d h %d min' $(( m / 60 )) $(( m % 60 )); else printf '%d min' "$m"; fi
}

# Write stdin to $1 atomically (temp file in the same directory, then rename).
put() {
  local tmp
  tmp=$(mktemp "$1.XXXXXX") || return 1
  if cat >"$tmp" && mv -f "$tmp" "$1"; then return 0; fi
  rm -f "$tmp"; return 1
}

# The web UI reads the cache from here, so the directory stays world-readable.
mkdir -p -m 755 "$STATE_DIR" || exit 1
if (( ! CHECK )); then
  exec 9>"$STATE_DIR/lock"
  flock -n 9 || exit 0   # previous run still going
fi

# Cron wake-up: leave quietly unless the last run's schedule says a check is due.
if (( CRON )); then
  due=$(jq -r '.next // 0' "$CACHE" 2>/dev/null) || due=0
  [[ $due =~ ^[0-9]+$ ]] || due=0
  (( NOW + CRON_SLACK >= due )) || exit 0
fi

# --- dates (all UTC) --------------------------------------------------------
TODAY=$(date -u -d "@$NOW" +%F)
SINCE=$(date -u -d "$TODAY -6 days" +%F)
NOW_ISO=$(date -u -d "@$NOW" +%FT%TZ)
RESET=$(date -u -d "$TODAY +1 day" +%s)
DATES=$(for i in 6 5 4 3 2 1 0; do date -u -d "$TODAY -$i days" +%F; done | jq -Rsc 'split("\n") | map(select(length > 0))')

# --- config -----------------------------------------------------------------
ACCOUNT_ID=$(cfg ACCOUNT_ID "")
ACCOUNT_ID=${ACCOUNT_ID,,}
TOKEN_FILE=$(cfg TOKEN_FILE "$CFG_DIR/cf-api-token")
CAP_WORKERS=$(num_or "$(cfg CAP_WORKERS 100000)" 100000)
CAP_DO=$(num_or "$(cfg CAP_DO 100000)" 100000)
CAP_DO_WRITE=$(num_or "$(cfg CAP_DO_WRITE 100000)" 100000)
CAP_DO_READ=$(num_or "$(cfg CAP_DO_READ 5000000)" 5000000)
CAP_DO_GBS=$(num_or "$(cfg CAP_DO_GBS 13000)" 13000)
CAP_D1_WRITE=$(num_or "$(cfg CAP_D1_WRITE 100000)" 100000)
CAP_D1_READ=$(num_or "$(cfg CAP_D1_READ 5000000)" 5000000)
CAP_KV_READ=$(num_or "$(cfg CAP_KV_READ 100000)" 100000)
CAP_KV_WRITE=$(num_or "$(cfg CAP_KV_WRITE 1000)" 1000)
CAP_KV_DELETE=$(num_or "$(cfg CAP_KV_DELETE 1000)" 1000)
CAP_KV_LIST=$(num_or "$(cfg CAP_KV_LIST 1000)" 1000)
CAP_AI=$(num_or "$(cfg CAP_AI_NEURONS 10000)" 10000)
ERR_ALERT_MIN=$(num_or "$(cfg ERROR_ALERT_MIN 50)" 50)        # at least this many failed requests today
ERR_ALERT_PCT=$(num_or "$(cfg ERROR_ALERT_PERCENT 5)" 5)      # and at least this share of requests

# One entry per free-plan daily cap.
#   srcs: the queries that report it.  keys: history fields summed into its value.
#   opt:  shown on the tile only once used in the last 7 days (alerts work regardless).
# Pages Functions requests count toward the same 100k cap as Workers, so they
# are added to the Workers bar. Durable Objects on Workers Free are
# SQLite-backed, so their storage has its own rows caps (separate from D1's).
DEFS=$(jq -nc --argjson w "$CAP_WORKERS" --argjson o "$CAP_DO" --argjson ow "$CAP_DO_WRITE" --argjson or "$CAP_DO_READ" \
  --argjson og "$CAP_DO_GBS" --argjson dw "$CAP_D1_WRITE" --argjson dr "$CAP_D1_READ" \
  --argjson kr "$CAP_KV_READ" --argjson kw "$CAP_KV_WRITE" --argjson kd "$CAP_KV_DELETE" --argjson kl "$CAP_KV_LIST" \
  --argjson ai "$CAP_AI" '[
  {id: "workers",   srcs: ["workers", "pages"], keys: ["workers", "pages"], label: "Workers requests", short: "Workers", cap: $w},
  {id: "do",        srcs: ["do"],       label: "Durable Objects requests", short: "DO",        cap: $o},
  {id: "do_write",  srcs: ["do_store"], label: "DO storage rows written",  short: "DO writes", cap: $ow},
  {id: "do_read",   srcs: ["do_store"], label: "DO storage rows read",     short: "DO reads",  cap: $or},
  {id: "do_gbs",    srcs: ["do_store"], label: "DO duration (GB-s)",       short: "DO GB-s",   cap: $og},
  {id: "d1_write",  srcs: ["d1"],       label: "D1 rows written",          short: "D1 writes", cap: $dw},
  {id: "d1_read",   srcs: ["d1"],       label: "D1 rows read",             short: "D1 reads",  cap: $dr},
  {id: "kv_read",   srcs: ["kv"], opt: true, label: "KV reads",            short: "KV reads",  cap: $kr},
  {id: "kv_write",  srcs: ["kv"], opt: true, label: "KV writes",           short: "KV writes", cap: $kw},
  {id: "kv_delete", srcs: ["kv"], opt: true, label: "KV deletes",          short: "KV deletes", cap: $kd},
  {id: "kv_list",   srcs: ["kv"], opt: true, label: "KV lists",            short: "KV lists",  cap: $kl},
  {id: "ai",        srcs: ["ai"], opt: true, label: "Workers AI neurons",  short: "AI",        cap: $ai}
  ] | map(.keys //= [.id])')
SOURCES="workers pages do do_store kv ai d1"

TOKEN=""
CFG_ERR=""
SETUP_HINT="Open Settings → Cloudflare Usage to set it up."
if [[ ! $ACCOUNT_ID =~ ^[0-9a-f]{32}$ ]]; then
  CFG_ERR="Not set up: no Cloudflare account ID yet. $SETUP_HINT"
elif [[ ! -r $TOKEN_FILE ]]; then
  CFG_ERR="Not set up: no API token saved yet (Account Analytics: Read). $SETUP_HINT"
else
  TOKEN=$(tr -d '[:space:]' <"$TOKEN_FILE")
  # The token goes inside a quoted curl config line, so allow only token-safe characters.
  if [[ -z $TOKEN ]]; then
    CFG_ERR="The saved API token is empty. Save it again in Settings → Cloudflare Usage."
  elif [[ ! $TOKEN =~ ^[A-Za-z0-9._~+/=-]{20,256}$ ]]; then
    TOKEN=""
    CFG_ERR="The saved API token isn't valid (wrong length or characters). Save it again in Settings → Cloudflare Usage."
  fi
fi

# --- Cloudflare API ---------------------------------------------------------
# request URL [JSON]: GET, or POST when a JSON body is given. Sets BODY and
# CODE. The auth header reaches curl through a pipe from the printf builtin,
# never through argv.
BODY="" CODE="" ERR=""
request() {
  local out errf=$STATE_DIR/curl.err
  local args=(-sS -K - --max-time 30 --retry 2 --retry-delay 5 -H 'Accept: application/json' -w '\n%{http_code}')
  [[ -n ${2:-} ]] && args+=(-H 'Content-Type: application/json' --data-binary "$2")
  out=$(printf 'header = "Authorization: Bearer %s"\n' "$TOKEN" | "$CURL" "${args[@]}" "$1" 2>"$errf")
  CODE=${out##*$'\n'}
  BODY=${out%$'\n'*}
  [[ $CODE =~ ^[0-9]{3}$ ]] || CODE=000
  if [[ $CODE == 000 ]]; then
    ERR="Could not reach Cloudflare: $(head -n 1 "$errf" 2>/dev/null | cut -c1-200)"
  elif [[ $CODE != 200 ]]; then
    ERR=$(jq -r '(.errors // [])[0].message // empty' <<<"$BODY" 2>/dev/null | head -n 1)
    ERR="HTTP $CODE: ${ERR:-$(head -n 1 <<<"$BODY" | cut -c1-200)}"
  else
    ERR=""
  fi
  ERR=${ERR//"$TOKEN"/[redacted]}
}

# gql QUERY: returns 0 on success, 1 on a GraphQL error (HTTP 200), 2 on a
# transport or HTTP error. On failure ERR holds a one-line message.
gql() {
  request "$API" "$(jq -nc --arg q "$1" '{query: $q}')"
  [[ $CODE == 200 ]] || return 2
  ERR=$(jq -r '
    if ((.errors // []) | length) > 0 then (.errors[0].message // "unknown API error")
    elif ((.data.viewer.accounts // []) | length) == 0 then "Account not found, or the token cannot read its analytics"
    else empty end' <<<"$BODY" 2>/dev/null) || ERR="Unreadable API response"
  ERR=${ERR//"$TOKEN"/[redacted]}
  [[ -z $ERR ]] && return 0
  ERR=$(head -n 1 <<<"$ERR" | cut -c1-200)
  return 1
}

# Queries use literals rather than variables: every value is validated above
# (hex account ID, dates and times built by date(1)), so nothing is injected.
acct_q() { printf '{ viewer { accounts(filter: {accountTag: "%s"}) { %s } } }' "$ACCOUNT_ID" "$1"; }
by_date() { # node fields start
  acct_q "$(printf '%s(limit: %s, filter: {date_geq: "%s", date_leq: "%s"}) { sum { %s } dimensions { %s } }' "$1" "$4" "$3" "$TODAY" "$2" "${5:-date}")"
}
q_workers()  { acct_q "$(printf 'workersInvocationsAdaptive(limit: 2000, filter: {datetime_geq: "%sT00:00:00Z", datetime_leq: "%s"}) { sum { requests errors } dimensions { datetimeHour } }' "$1" "$NOW_ISO")"; }
q_pages()    { by_date pagesFunctionsInvocationsAdaptiveGroups "requests" "$1" 100; }
q_do()       { by_date durableObjectsInvocationsAdaptiveGroups "requests" "$1" 100; }
q_do_store() { by_date durableObjectsPeriodicGroups "rowsRead rowsWritten duration" "$1" 100; }
q_kv()       { by_date kvOperationsAdaptiveGroups "requests" "$1" 1000 "date actionType"; }
q_ai()       { by_date aiInferenceAdaptiveGroups "totalNeurons" "$1" 100; }
q_d1()       { by_date d1AnalyticsAdaptiveGroups "rowsRead rowsWritten" "$1" 100; }

# Turn a response into {"YYYY-MM-DD": {"field": n, ...}}, filling every date
# in the queried range with 0 where Cloudflare returned no rows.
J_PRELUDE='def days($from): $dates | map(select(. >= $from));
def fill($from; $keys): . as $m | reduce days($from)[] as $d ($m; .[$d] = ((reduce $keys[] as $k ({}; .[$k] = 0)) + (.[$d] // {})));
def rows($node): .data.viewer.accounts[0][$node] // [];
def per_date($node; f): rows($node) | group_by(.dimensions.date) | map({key: .[0].dimensions.date, value: f}) | from_entries;'
parse() { # parse SRC FROM
  local f
  case $1 in
    workers) f='rows("workersInvocationsAdaptive")
      | map({d: (.dimensions.datetimeHour // "")[0:10], v: (.sum.requests // 0), e: (.sum.errors // 0)}) | map(select(.d != ""))
      | group_by(.d) | map({key: .[0].d, value: {workers: (map(.v) | add), workers_err: (map(.e) | add)}}) | from_entries
      | fill($from; ["workers", "workers_err"])' ;;
    pages) f='per_date("pagesFunctionsInvocationsAdaptiveGroups"; {pages: (map(.sum.requests // 0) | add)}) | fill($from; ["pages"])' ;;
    do) f='per_date("durableObjectsInvocationsAdaptiveGroups"; {do: (map(.sum.requests // 0) | add)}) | fill($from; ["do"])' ;;
    do_store) f='per_date("durableObjectsPeriodicGroups"; {
          do_read: (map(.sum.rowsRead // 0) | add), do_write: (map(.sum.rowsWritten // 0) | add),
          do_gbs: (map(.sum.duration // 0) | add | . * 10 | round / 10)})
      | fill($from; ["do_read", "do_write", "do_gbs"])' ;;
    kv) f='per_date("kvOperationsAdaptiveGroups"; reduce .[] as $r ({};
          .["kv_" + ($r.dimensions.actionType // "other")] += ($r.sum.requests // 0)) | with_entries(select(.key | IN("kv_read", "kv_write", "kv_delete", "kv_list"))))
      | fill($from; ["kv_read", "kv_write", "kv_delete", "kv_list"])' ;;
    ai) f='per_date("aiInferenceAdaptiveGroups"; {ai: (map(.sum.totalNeurons // 0) | add | floor)}) | fill($from; ["ai"])' ;;
    d1) f='per_date("d1AnalyticsAdaptiveGroups"; {
          d1_read: (map(.sum.rowsRead // 0) | add), d1_write: (map(.sum.rowsWritten // 0) | add)})
      | fill($from; ["d1_read", "d1_write"])' ;;
  esac
  jq -c --argjson dates "$DATES" --arg from "$2" "$J_PRELUDE $f" <<<"$BODY"
}

# fetch SRC: try the last 7 days; if the plan rejects that range, fall back to
# today only (the local history file then fills in earlier days).
# Sets DAYMAP (JSON) on success, SRC_ERR on failure.
DAYMAP="{}" SRC_ERR=""
fetch() {
  local src=$1 from rc
  DAYMAP="{}" SRC_ERR=""
  for from in "$SINCE" "$TODAY"; do
    gql "$(q_"$src" "$from")"; rc=$?
    if (( rc == 0 )); then
      DAYMAP=$(parse "$src" "$from") && return 0
      SRC_ERR="Unexpected response shape"; return 1
    fi
    SRC_ERR=$ERR
    (( rc == 1 )) && [[ $from != "$TODAY" ]] && continue   # GraphQL error: retry with a smaller range
    return 1
  done
  return 1
}

# token_info: the token's status and expiry from Cloudflare's verify endpoint
# (account-owned tokens first, then user tokens). Prints JSON, or fails.
token_info() {
  local path
  for path in "/accounts/$ACCOUNT_ID/tokens/verify" "/user/tokens/verify"; do
    request "$API_BASE$path"
    [[ $CODE == 200 ]] || continue
    jq -ce --argjson now "$NOW" '
      select(.success == true) | .result
      | {checked: $now, status: (.status // "unknown"),
         expires: (.expires_on // null | if . == null then null else (sub("\\.[0-9]+"; "") | fromdateiso8601) end)}' <<<"$BODY" 2>/dev/null &&
      return 0
  done
  return 1
}

# --- --check: report and exit -----------------------------------------------
if (( CHECK )); then
  [[ -z $CFG_ERR ]] || { echo "$CFG_ERR"; exit 1; }
  echo "Account $ACCOUNT_ID, token file $TOKEN_FILE (token not shown)"
  if t=$(token_info); then
    jq -r --argjson now "$NOW" '"Token: \(.status), " + (if .expires == null then "no expiry date"
      else "expires \(.expires | strftime("%Y-%m-%d")) (in \(((.expires - $now) / 86400) | floor) days)" end)' <<<"$t"
  else
    echo "Token: could not read its status or expiry ($ERR)"
  fi
  q=$(acct_q 'settings {
      workersInvocationsAdaptive { enabled maxDuration notOlderThan availableFields }
      pagesFunctionsInvocationsAdaptiveGroups { enabled maxDuration notOlderThan availableFields }
      durableObjectsInvocationsAdaptiveGroups { enabled maxDuration notOlderThan availableFields }
      durableObjectsPeriodicGroups { enabled maxDuration notOlderThan availableFields }
      kvOperationsAdaptiveGroups { enabled maxDuration notOlderThan availableFields }
      aiInferenceAdaptiveGroups { enabled maxDuration notOlderThan availableFields }
      d1AnalyticsAdaptiveGroups { enabled maxDuration notOlderThan availableFields } }')
  if gql "$q"; then
    jq -r '
      {workersInvocationsAdaptive: ["sum_requests", "sum_errors", "dimensions_datetimeHour"],
       pagesFunctionsInvocationsAdaptiveGroups: ["sum_requests", "dimensions_date"],
       durableObjectsInvocationsAdaptiveGroups: ["sum_requests", "dimensions_date"],
       durableObjectsPeriodicGroups: ["sum_rowsRead", "sum_rowsWritten", "sum_duration", "dimensions_date"],
       kvOperationsAdaptiveGroups: ["sum_requests", "dimensions_date", "dimensions_actionType"],
       aiInferenceAdaptiveGroups: ["sum_totalNeurons", "dimensions_date"],
       d1AnalyticsAdaptiveGroups: ["sum_rowsRead", "sum_rowsWritten", "dimensions_date"]} as $need
      | .data.viewer.accounts[0].settings | to_entries[]
      | .key as $k | .value as $s
      | (($need[$k] // []) - ($s.availableFields // [])) as $missing
      | "\($k): enabled=\($s.enabled), max range \(($s.maxDuration // 0) / 86400 * 10 | floor / 10) days, history \(($s.notOlderThan // 0) / 86400 | floor) days"
        + (if ($missing | length) > 0 then ", MISSING fields: \($missing | join(" "))" else ", needed fields present" end)' <<<"$BODY"
  else
    echo "Settings query failed: $ERR"
  fi
  status=0
  for src in $SOURCES; do
    if fetch "$src"; then
      echo "$src: today $(jq -c --arg t "$TODAY" '.[$t] // {}' <<<"$DAYMAP"), days returned: $(jq -r 'keys | length' <<<"$DAYMAP")"
    else
      echo "$src: FAILED: $SRC_ERR"; status=1
    fi
  done
  exit $status
fi

# --- normal run ---------------------------------------------------------------
HIST=$(cat "$HIST_RAM" 2>/dev/null || cat "$HIST_FLASH" 2>/dev/null || echo '{}')
jq -e 'type == "object"' <<<"$HIST" >/dev/null 2>&1 || HIST='{}'
PREV=$(cat "$CACHE" 2>/dev/null || echo '{}')
jq -e 'type == "object"' <<<"$PREV" >/dev/null 2>&1 || PREV='{}'

ERRS='{}'
ok_count=0
if [[ -z $CFG_ERR ]]; then
  for src in $SOURCES; do
    if fetch "$src"; then
      HIST=$(jq -c --argjson m "$DAYMAP" '. * $m' <<<"$HIST")
      ok_count=$(( ok_count + 1 ))
    else
      ERRS=$(jq -c --arg s "$src" --arg e "$SRC_ERR" '.[$s] = $e' <<<"$ERRS")
    fi
  done
fi

# Token status and expiry: once a day, or right away when the token file changes.
TOKJSON=$(cat "$TOKEN_STATE" 2>/dev/null || echo '{}')
jq -e 'type == "object"' <<<"$TOKJSON" >/dev/null 2>&1 || TOKJSON='{}'
if [[ -z $CFG_ERR ]]; then
  checked=$(jq -r '.checked // 0' <<<"$TOKJSON")
  if (( NOW - checked >= TOKEN_RECHECK )) || [[ $(stat -c %Y "$TOKEN_FILE" 2>/dev/null || echo 0) -gt $checked ]]; then
    if t=$(token_info); then
      TOKJSON=$t
      printf '%s\n' "$TOKJSON" | put "$TOKEN_STATE"
    fi
  fi
else
  TOKJSON='{}'
fi

# Keep the last 7 UTC days.
HIST=$(jq -c --arg since "$SINCE" 'with_entries(select(.key >= $since))' <<<"$HIST")
printf '%s\n' "$HIST" | put "$HIST_RAM"

# Completed days go to the flash drive so history survives a reboot. Write only
# when a day is added or dropped, or at most every 6 hours, to spare the flash.
DONE_DAYS=$(jq -c --arg t "$TODAY" 'with_entries(select(.key < $t))' <<<"$HIST")
OLD_DONE=$(cat "$HIST_FLASH" 2>/dev/null || echo '{}')
if [[ $DONE_DAYS != "$OLD_DONE" ]]; then
  if [[ $(jq -c 'keys' <<<"$DONE_DAYS") != "$(jq -c 'keys' <<<"$OLD_DONE" 2>/dev/null)" ]] ||
     [[ ! -f $HIST_FLASH ]] || (( NOW - $(stat -c %Y "$HIST_FLASH") > 21600 )); then
    printf '%s\n' "$DONE_DAYS" | put "$HIST_FLASH" || log "could not write $HIST_FLASH"
  fi
fi

# The cache also carries the schedule: "next" is when the next --cron run
# should query Cloudflare (see the header for the rules).
jq -n --argjson hist "$HIST" --argjson prev "$PREV" --argjson errs "$ERRS" --argjson defs "$DEFS" \
  --argjson dates "$DATES" --arg today "$TODAY" --argjson now "$NOW" --argjson reset "$RESET" \
  --arg cfgerr "$CFG_ERR" --arg acct "$ACCOUNT_ID" --argjson token "$TOKJSON" \
  --argjson errmin "$ERR_ALERT_MIN" --argjson errpct "$ERR_ALERT_PCT" '
  def prevm($id): if ($prev.day // "") == $today then (($prev.metrics // []) | map(select(.id == $id)) | .[0] // {}) else {} end;
  # A metric value is the sum of its history fields; null when none were ever fetched.
  def val($day; $m): [$m.keys[] as $k | $hist[$day][$k] | select(. != null)] | if length == 0 then null else add end;
  # Base gap from the busiest cap.
  def tier($pct): if $pct >= 85 then 300 elif $pct >= 75 then 600 else 900 end;
  # Seconds until metric $m reaches its next threshold at the growth rate seen
  # since the previous reading today (null if not growing or no usable reading).
  def eta($m): prevm($m.id) as $p
    | if $m.value == null or $m.error != "" or ($p.value // null) == null or ($p.fetched // null) == null
         or $now - $p.fetched < 240 or $m.value <= $p.value then null
      else (($m.value - $p.value) / ($now - $p.fetched)) as $rate
        | ([0.75, 0.9, 1] | map(. * $m.cap) | map(select(. > $m.value)) | .[0]) as $t
        | if $t == null then null else ($t - $m.value) / $rate end
      end;
  {
    schema: 2,
    generated: $now,
    day: $today,
    reset: $reset,
    account: $acct,
    error: $cfgerr,
    token: $token,
    metrics: [ $defs[] as $m
      | ([$m.srcs[] as $s | $errs[$s] // empty | "\($s): \(.)"] | join("; ")) as $err
      | {
        id: $m.id, label: $m.label, short: $m.short, cap: $m.cap, optional: ($m.opt // false),
        value: val($today; $m),
        error: (if $cfgerr != "" then "" else $err end),
        fetched: (if $cfgerr == "" and $err == "" then $now else (prevm($m.id).fetched // null) end),
        # Optional caps (KV, Workers AI) appear once used in the last 7 days.
        visible: (if ($m.opt // false) then ([$dates[] as $d | val($d; $m) // 0] | add) > 0 else true end)
      }
      | if .id == "workers" then
          . + {pages: ($hist[$today].pages // 0), errors: ($hist[$today].workers_err // null),
               requests_only: ($hist[$today].workers // null)}
          | .errors_high = ((.errors // 0) >= $errmin and (.requests_only // 0) > 0
                            and ((.errors // 0) * 100) >= ($errpct * .requests_only))
        else . end ],
    history: [ $dates[] as $d | {day: $d} + (reduce $defs[] as $m ({}; .[$m.id] = val($d; $m))) ]
  }
  | .interval = (
      if $cfgerr != "" then 300   # nothing to query; pick up new settings quickly
      else
        ([.metrics[] | select(.value != null) | .value * 100 / .cap] | max // 0) as $top
        | ([.metrics[] | eta(.) | select(. != null)] | min) as $soonest
        | [tier($top), ($soonest // 900)] | min | [., 300] | max | floor
      end)
  | .next = $now + .interval' | put "$CACHE" || { log "could not write $CACHE"; exit 1; }
chmod 644 "$CACHE" 2>/dev/null

# --- logging: once per change, not every run ------------------------------------
summary=$CFG_ERR
[[ -n $summary ]] || summary=$(jq -r 'to_entries | map("\(.key): \(.value)") | join("; ")' <<<"$ERRS")
if [[ $summary != "$(cat "$LAST_ERR" 2>/dev/null)" ]]; then
  if [[ -n $summary ]]; then log "$summary"; else log "Cloudflare usage check OK again"; fi
  printf '%s' "$summary" | put "$LAST_ERR"
fi

# --- alerts -----------------------------------------------------------------------
# Cap, error and failure alerts are recorded as "<day> <what> <level>" and
# forgotten the next UTC day. Token alerts are recorded as
# "token <expiry> <days>" and kept until the token changes.
sent_today() { grep -qx "$TODAY $1 $2" "$ALERTS" 2>/dev/null; }
sent_ever()  { grep -qx "$1" "$ALERTS" 2>/dev/null; }
NEW_SENT=()

notify() { # importance subject description message [link]
  "$NOTIFY" -e "Cloudflare usage" -s "$2" -d "$3" -m "$4" -i "$1" -l "${5:-/Dashboard}" >/dev/null 2>&1 ||
    log "notify failed: $2"
}

left="$(dur $(( RESET - NOW )))"
while IFS=$'\t' read -r id label value cap; do
  [[ -n $id ]] || continue
  level=0
  if (( value * 100 >= 90 * cap )); then level=90
  elif (( value * 100 >= 75 * cap )); then level=75
  fi
  (( level )) || continue
  sent_today "$id" "$level" && continue
  pct=$(( value * 100 / cap ))
  case $id in
    workers) after="Past the cap, Workers and Pages Functions on this account return Error 1027 (or skip the Worker if its route fails open) until the reset." ;;
    do)      after="Past the cap, Durable Object requests fail until the reset." ;;
    do_write|do_read) after="Past the cap, Durable Object storage operations of that kind fail until the reset." ;;
    do_gbs)  after="Past the cap, Durable Objects stop running until the reset." ;;
    kv_*)    after="Past the cap, KV operations of that kind fail until the reset." ;;
    ai)      after="Past the cap, Workers AI requests fail until the reset (more needs the Workers Paid plan)." ;;
    *)       after="Past the cap, D1 queries that need more rows fail until the reset." ;;
  esac
  imp=warning; (( level == 90 )) && imp=alert
  notify "$imp" "$label at $pct% of the free daily cap" \
    "$(commas "$value") of $(commas "$cap") used today (UTC). Resets at 00:00 UTC, in $left." "$after"
  # One alert per threshold per day; jumping straight past 90% sends only the 90% alert.
  NEW_SENT+=("$TODAY $id 75")
  (( level == 90 )) && NEW_SENT+=("$TODAY $id 90")
done < <(jq -r '.metrics[] | select(.value != null) | [.id, .label, (.value | floor), .cap] | @tsv' "$CACHE")

# Worker errors: once a day when failures are both numerous and a real share.
read -r errs reqs high < <(jq -r '.metrics[] | select(.id == "workers") | "\(.errors // 0) \(.requests_only // 0) \(.errors_high)"' "$CACHE")
if [[ ${high:-false} == true ]] && ! sent_today worker-errors 1; then
  notify warning "Cloudflare Worker errors: $(commas "$errs") failed requests today" \
    "$(commas "$errs") of $(commas "$reqs") Worker requests failed today (UTC), $(( errs * 100 / reqs ))%." \
    "Open Workers & Pages, your Worker, Observability to see why. Common causes: an uncaught exception, or going over the Free plan's 10 ms CPU limit per request." \
    "https://dash.cloudflare.com/$ACCOUNT_ID/workers-and-pages"
  NEW_SENT+=("$TODAY worker-errors 1")
fi

# Token expiry: a warning 30 days out, then alerts at 7 days and 1 day.
read -r texp tstatus < <(jq -r '"\(.token.expires // "none") \(.token.status // "unknown")"' "$CACHE")
if [[ $texp =~ ^[0-9]+$ ]]; then
  days=$(( (texp - NOW) / 86400 ))
  edate=$(date -u -d "@$texp" +%F)
  level=0
  if (( days <= 1 )); then level=1; elif (( days <= 7 )); then level=7; elif (( days <= 30 )); then level=30; fi
  if (( level )) && (( texp > NOW )) && ! sent_ever "token $texp $level"; then
    imp=alert; (( level == 30 )) && imp=warning
    when="in $days days"; (( days < 1 )) && when="within a day"; (( days == 1 )) && when="tomorrow"
    notify "$imp" "Cloudflare API token expires $when" \
      "The read-only token Cloudflare Usage uses expires on $edate (UTC). After that, usage checks and cap alerts stop." \
      "Create a new token (Account Analytics: Read) and save it in Settings → Cloudflare Usage." "$SETTINGS_LINK"
    for l in 30 7 1; do (( l >= level )) && NEW_SENT+=("token $texp $l"); done
  fi
fi

# Tell the user once a day if every query has been failing for a while, since
# a broken poller would otherwise mean no alerts at all.
if [[ -z $CFG_ERR ]] && (( ok_count == 0 )); then
  [[ -s $FAIL_SINCE ]] || printf '%s' "$NOW" | put "$FAIL_SINCE"
  since=$(cat "$FAIL_SINCE")
  if (( NOW - since >= FAIL_ALERT_AFTER )) && ! sent_today poll-failing 1; then
    notify warning "Cloudflare usage check is failing" \
      "No usage data since $(date -d "@$since" '+%H:%M'). Cap alerts are paused until it works again." \
      "$(jq -r 'to_entries | map("\(.key): \(.value)") | join("; ")' <<<"$ERRS")" "$SETTINGS_LINK"
    NEW_SENT+=("$TODAY poll-failing 1")
  fi
else
  rm -f "$FAIL_SINCE"
fi

if (( ${#NEW_SENT[@]} )); then
  # Keep today's records and the current token's; drop the rest.
  { grep -E "^($TODAY|token ${texp:-none}) " "$ALERTS" 2>/dev/null; printf '%s\n' "${NEW_SENT[@]}"; } | sort -u | put "$ALERTS" ||
    log "could not write $ALERTS"
fi
exit 0
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/cloudflare.usage.cron" Mode="0644">
<INLINE><![CDATA[
# cloudflare.usage: wake every 5 minutes; the poller queries Cloudflare every 15, 10 or 5 minutes depending on usage
2,7,12,17,22,27,32,37,42,47,52,57 * * * * /usr/local/emhttp/plugins/cloudflare.usage/scripts/poll --cron >/dev/null 2>&1
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/cloudflare.usage.cfg.default" Mode="0644">
<INLINE><![CDATA[
# cloudflare.usage settings. Read by /usr/local/emhttp/plugins/cloudflare.usage/scripts/poll.
# Settings → Cloudflare Usage edits ACCOUNT_ID and the token for you.
# Changes apply within 15 minutes (5 while not set up); no restart needed. To apply now:
#   /usr/local/emhttp/plugins/cloudflare.usage/scripts/poll

# Cloudflare account ID: 32 hex characters, shown in the dashboard URL
# (dash.cloudflare.com/<account-id>/...) and on the Workers & Pages overview.
ACCOUNT_ID=""

# File holding the read-only API token (Account Analytics: Read, this account only).
TOKEN_FILE="/boot/config/plugins/cloudflare.usage/cf-api-token"

# Daily caps on the Workers Free plan. Change only if Cloudflare changes them.
CAP_WORKERS="100000"
CAP_DO="100000"
CAP_DO_WRITE="100000"
CAP_DO_READ="5000000"
CAP_DO_GBS="13000"
CAP_D1_WRITE="100000"
CAP_D1_READ="5000000"
CAP_KV_READ="100000"
CAP_KV_WRITE="1000"
CAP_KV_DELETE="1000"
CAP_KV_LIST="1000"
CAP_AI_NEURONS="10000"

# Worker error warning: at least this many failed requests in a UTC day,
# and at least this percentage of the day's requests.
ERROR_ALERT_MIN="50"
ERROR_ALERT_PERCENT="5"
]]></INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE><![CDATA[
#!/bin/bash
# cloudflare.usage install step. The plugin manager runs this after writing the plugin
# files, on first install, on upgrade, and again at every boot.
set -u
PLUG=/usr/local/emhttp/plugins/cloudflare.usage
CFG=/boot/config/plugins/cloudflare.usage

mkdir -p "$CFG"
mkdir -p -m 755 /var/local/cloudflare.usage

# Default settings, only if none exist yet (keeps writes to the flash drive rare).
[[ -f $CFG/cloudflare.usage.cfg ]] || cp "$PLUG/cloudflare.usage.cfg.default" "$CFG/cloudflare.usage.cfg"

# update_cron builds root's crontab from /boot/config/plugins/<name>/*.cron, but
# only for plugins listed in /var/log/plugins. Write the cron file only if it changed.
if ! cmp -s "$PLUG/cloudflare.usage.cron" "$CFG/cloudflare.usage.cron"; then
  cp "$PLUG/cloudflare.usage.cron" "$CFG/cloudflare.usage.cron"
fi

# The plugin manager lists this plugin in /var/log/plugins only after this script
# succeeds, so an update_cron run right now would skip it. Wait for the listing
# in the background, then load the crontab and take the first reading.
setsid bash -c '
  for _ in $(seq 1 600); do [[ -e /var/log/plugins/cloudflare.usage.plg ]] && break; sleep 1; done
  /usr/local/sbin/update_cron
  /usr/local/emhttp/plugins/cloudflare.usage/scripts/poll
' </dev/null >/dev/null 2>&1 &

# What the install dialog shows (live on Unraid 7.4+). 2026.11.12c is filled in by build.sh.
echo ""
echo "Cloudflare Usage 2026.11.12c"
# Only say more when there is something to do: a fresh install with no settings yet.
if ! grep -qE '^ACCOUNT_ID="[0-9a-f]{32}"' "$CFG/cloudflare.usage.cfg" 2>/dev/null || [[ ! -s $CFG/cf-api-token ]]; then
  echo "Next: open Settings > Cloudflare Usage (or click this plugin's icon) to add your account ID and API token."
fi
echo ""
]]></INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[
#!/bin/bash
# cloudflare.usage remove step. The plugin manager runs update_cron after this, which
# drops the cron entry.
rm -f /boot/config/plugins/cloudflare.usage/cloudflare.usage.cron
rm -rf /usr/local/emhttp/plugins/cloudflare.usage /var/local/cloudflare.usage
echo ""
echo "cloudflare.usage removed. Your settings, API token and history remain in /boot/config/plugins/cloudflare.usage."
echo "Delete that folder to remove them too:  rm -r /boot/config/plugins/cloudflare.usage"
echo ""
]]></INLINE>
</FILE>

</PLUGIN>
